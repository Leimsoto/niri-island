#!/bin/sh
# greetd's default_session: niri with the greeter's minimal config.
#
# Safety net: the greeter marks a started session with an "ok" file. If it
# is not there when niri ends (the greeter or niri failed), the previous
# greeter (saved by the installer) takes over, so login never gets stuck.

dir="/tmp/niri-island-greeter-$(id -u)"
mkdir -p "$dir" && chmod 700 "$dir"
rm -f "$dir/ok"
exec >"$dir/log" 2>&1
echo "=== $(date -Iseconds) GREETD_SOCK=${GREETD_SOCK:-unset} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}"

# greetd may not give the greeter a runtime dir: make one.
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -w "${XDG_RUNTIME_DIR}" ]; then
    XDG_RUNTIME_DIR="$dir/runtime"
    mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
fi
export XDG_RUNTIME_DIR NIRI_ISLAND_GREETER_DIR="$dir"
unset WAYLAND_DISPLAY
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"

if command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- niri -c /etc/niri-island/greeter.kdl
else
    niri -c /etc/niri-island/greeter.kdl
fi
echo "niri terminó con $?"

[ -f "$dir/ok" ] && exit 0
fallback="$(cat /etc/niri-island/greeter-fallback 2>/dev/null)"
if [ -n "$fallback" ]; then
    echo "el greeter no inició sesión: paso a $fallback"
    exec $fallback
fi
exit 1
